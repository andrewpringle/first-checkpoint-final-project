public class Room {
    String name;
    String description;
    String north;
    String south;
    String east;
    String west;

    Room(String name, String description, String north, String south, String east, String west) {
        this.name        = name;
        this.description = description;
        this.north       = north;
        this.south       = south;
        this.east        = east;
        this.west        = west;
    }

    String getExit(String dir) {
        if (dir.equals("north")) return north;
        if (dir.equals("south")) return south;
        if (dir.equals("east"))  return east;
        if (dir.equals("west"))  return west;
        return null;
    }
}
